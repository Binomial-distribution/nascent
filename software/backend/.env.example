# 部署密钥：复制本文件为 software/backend/secrets/.env 后填写。
# 不要提交真实密钥。进程仍可用环境变量 NASCENT_* 覆盖。
# 本机开发也可以继续用 software/backend/.env（较低优先级）。
NASCENT_LLM_API_KEY=
# 控制台是 https://cloud.siliconflow.cn/ ，Chat/Control 9B 必须用 OpenAI 兼容根地址。
NASCENT_LLM_BASE_URL=https://api.siliconflow.cn/v1
# 逻辑别名 nascent-chat-9b / nascent-control-9b 由后端文档解释。
# 下面三项必须是供应商认识的模型 ID，第一阶段都指向同一快照。
NASCENT_LLM_MODEL=Qwen/Qwen3.5-9B
NASCENT_CHAT_LLM_MODEL=Qwen/Qwen3.5-9B
NASCENT_CONTROL_LLM_MODEL=Qwen/Qwen3.5-9B
NASCENT_LLM_TIMEOUT_S=3.0
NASCENT_CHAT_LLM_TIMEOUT_S=8.0
NASCENT_CONTROL_LLM_TIMEOUT_S=2.5
# 语音可留空：空则复用上面的 LLM 地址和密钥。PCM 只到 ASR，不进 Chat 9B。
NASCENT_SPEECH_API_KEY=
NASCENT_SPEECH_BASE_URL=
NASCENT_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# MiniMax 系统音色免费，走国内 t2a_v2。密钥在 https://platform.minimaxi.com/user-center/basic-information/interface-key
# GroupId 可空；新版接口密钥通常不需要。
NASCENT_MINIMAX_API_KEY=
NASCENT_MINIMAX_GROUP_ID=
NASCENT_MINIMAX_BASE_URL=https://api.minimaxi.com
NASCENT_TTS_MODEL=speech-02-turbo
# 默认男友系统音色。情景通话按人设覆盖。自定义声线本轮只在前端本地记下，不打克隆接口。
NASCENT_TTS_VOICE=junlang_nanyou
# minimax（默认）或 mimo。设置页也可切换；密钥只写本机 .env。
NASCENT_TTS_PROVIDER=minimax
NASCENT_MIMO_API_KEY=
NASCENT_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
NASCENT_MIMO_MODEL=mimo-v2.5-tts
NASCENT_ASR_TIMEOUT_S=8.0
NASCENT_TTS_TIMEOUT_S=20.0
# 设置页 POST /v1/runtime-config 的本机口令。未配置则公网 POST 一律 403。
# 本机 debug 且客户端是 127.0.0.1 / ::1 时可豁免。不要提交真实口令。
NASCENT_RUNTIME_TOKEN=
