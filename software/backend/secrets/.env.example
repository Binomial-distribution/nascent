# 部署用密钥目录。
#
# 复制：
#   cp .env.example .env
# 然后只在本机或部署主机填写。`.env` 已被 gitignore，不要提交真实密钥。
#
# 后端启动时优先读这里的 `.env`，其次才是 `software/backend/.env`。
# 进程环境变量 `NASCENT_*` 仍然覆盖文件里的值。
#
# —— 固有人设 001（Natsu）推荐用 Claude ——
NASCENT_LLM_PROVIDER=anthropic
NASCENT_LLM_API_KEY=
NASCENT_LLM_BASE_URL=https://api.anthropic.com
NASCENT_LLM_MODEL=claude-sonnet-4-20250514
NASCENT_CHAT_LLM_MODEL=claude-sonnet-4-20250514
NASCENT_CONTROL_LLM_MODEL=claude-sonnet-4-20250514
NASCENT_LLM_TIMEOUT_S=8.0
NASCENT_CHAT_LLM_TIMEOUT_S=45.0
NASCENT_CONTROL_LLM_TIMEOUT_S=8.0
#
# —— 或改回硅基 OpenAI 兼容 ——
# NASCENT_LLM_PROVIDER=openai
# NASCENT_LLM_BASE_URL=https://api.siliconflow.cn/v1
# NASCENT_LLM_MODEL=Qwen/Qwen3.5-9B
#
# 语音可留空。PCM 只到 ASR，不进 Chat。
NASCENT_SPEECH_API_KEY=
NASCENT_SPEECH_BASE_URL=
NASCENT_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
NASCENT_MINIMAX_API_KEY=
NASCENT_MINIMAX_GROUP_ID=
NASCENT_MINIMAX_BASE_URL=https://api.minimaxi.com
NASCENT_TTS_MODEL=speech-02-turbo
NASCENT_TTS_VOICE=junlang_nanyou
NASCENT_TTS_PROVIDER=minimax
NASCENT_MIMO_API_KEY=
NASCENT_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
NASCENT_MIMO_MODEL=mimo-v2.5-tts
NASCENT_ASR_TIMEOUT_S=8.0
NASCENT_TTS_TIMEOUT_S=20.0
# 设置页 POST /v1/runtime-config 的本机口令。未配置则公网 POST 一律 403。
# 本机 debug 且客户端是 127.0.0.1 / ::1 时可豁免。不要提交真实口令。
NASCENT_RUNTIME_TOKEN=
